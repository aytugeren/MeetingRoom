# Google Drive API - Service Account JSON'unun Base64 kodlanmış hali
# Nasıl oluşturulur (terminal):
#   cat service-account.json | base64 | tr -d '\n'
# Çıktıyı aşağıya yapıştır:
GOOGLE_CREDENTIALS_JSON_B64=your_base64_encoded_json_here

# Google Drive - Hedef klasör ID'si (Drive klasör URL'inden al)
# Örnek URL: https://drive.google.com/drive/folders/1A2B3C4D5E6F7G8H9I0J
DRIVE_FOLDER_ID=your_folder_id_here

# Upload request logger
# true  → her /api/upload isteğini (request + Drive request/response) JSON dosyasına yazar
# false / tanımsız → loglama kapalı
UPLOAD_LOG_ENABLED=false
UPLOAD_LOG_PATH=./logs/upload-requests.json

# TURN server (existing)
TURN_DOMAIN=
TURN_USER=
TURN_CREDENTIAL=
